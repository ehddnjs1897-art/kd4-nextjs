# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Kakao OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase

# ─── Cloudflare R2 (배우 출연영상 private 호스팅) ─────────────────────────────
# 가입: https://dash.cloudflare.com/sign-up
# R2 → Create bucket "kd4-actor-videos" → Manage API Tokens
R2_ACCOUNT_ID=                # Cloudflare 대시보드 우측 사이드바
R2_ACCESS_KEY_ID=             # R2 API Token 발급 시 노출
R2_SECRET_ACCESS_KEY=         # R2 API Token 발급 시 노출 (한 번만!)
R2_BUCKET_NAME=kd4-actor-videos

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kd4.club

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_KEY=                   # 서버 전용 — NEXT_PUBLIC_ 사용 금지 (키 노출 방지)

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Google Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Meta Pixel + CAPI ───────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=              # Meta Conversions API 서버 토큰 (없으면 CAPI 비활성)

# ─── SMS (Solapi) ─────────────────────────────────────────────────────────────
# https://console.solapi.com → API Key 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=           # 발신번호 (사전 등록 필요, 예: 01012345678)
ADMIN_PHONE_NUMBER=           # 대표 연락처 (신규 상담 알림 수신)
ADMIN_EMAIL=                  # 관리자 수신 이메일 (기본값: uikactors@gmail.com)

# ─── Make.com 웹훅 ────────────────────────────────────────────────────────────
MAKE_WEBHOOK_URL=             # Make.com → 구글시트 연동 웹훅 URL

# ─── 토스플레이스 Open API (사장님 포스 결제·현금영수증 → 노션 수강현황) ─────────
# developers.tossplace.com [내 애플리케이션] → [애플리케이션 등록](타입 API) → 인증 정보
TOSSPLACE_ACCESS_KEY=         # x-access-key
TOSSPLACE_SECRET_KEY=         # x-secret-key
TOSSPLACE_MERCHANT_ID=        # 매장고유번호 (developer-support@tossplace.com 실매장 연결 후 발급)
TOSSPLACE_WEBHOOK_SECRET=     # 웹훅 생성 시 발급되는 서명 시크릿 (없으면 /api/tossplace/webhook 은 404)
# TOSSPLACE_BASE_URL=https://open-api.tossplace.com/api-public/openapi/v1
# TOSSPLACE_TS_FORMAT=ms      # 주문 from/to 타임스탬프 형식 (ms | iso)
